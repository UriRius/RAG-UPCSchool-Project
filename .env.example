# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# OpenAI
OPENAI_API_KEY=sk-...

# App Password (for Streamlit UI)
APP_PASSWORD=tribunal2026

# Embedding model (optional override)
EMBEDDING_MODEL=BSC-LT/MrBERT-es

# RAG mode: v1 | v2 | v2_table | graph_baseline | cypher_transversal
# Demo Graph RAG v2:
RAG_MODE=cypher_transversal
CYPHER_ROUTE=hybrid

# ChromaDB — descargar con: python src/download_db.py
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=

# RAG v2 retrieval (BM25Log1 + pool amplio)
RETRIEVAL_K=50
V1_RETRIEVAL_K=5
TOP_N=10
RRF_K=60
RRF_MIN_SCORE=0.01
CYPHER_LIMIT=100
CYPHER_LLM_MODEL=gpt-4o-mini
GRAPH_MERGE_MIN_HITS=1
BM25_PATH=
EMBED_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_STYLE=tristan
HF_MODEL_PATH=./hf_model
RR_MODEL_PATH=./rr_model
RERANK_ENABLED=1
RERANK_POOL_N=20
REBUILD_BM25=0

# GCP Storage Bucket (Para automatizar descargas de DB)
GCP_BUCKET_NAME=rag-actas-db-bucket

# Google OAuth (MCP Drive en Cursor — ver config/mcp.google-drive.example.json)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Drive API — compartir la carpeta con la service account (credentials.json)
# como Lector antes de usar scripts/drive_phase0_inventory.py
# DRIVE_USE_ADC=1  # NO usar: gcloud ADC bloqueado para Drive
DRIVE_FOLDER_ID=1XyZ_abc123DEF456
# Carpeta chroma_db/ en Drive (MyDrive/RAG_UPC_Final_project/chroma_db)
DRIVE_CHROMA_FOLDER_ID=
# Carpeta graph/ en Drive (JSON del KG) — ID distinto al de actas .docx
DRIVE_GRAPH_FOLDER_ID=

# Neo4j Aura (Graph RAG — modo cypher_transversal en src/app.py)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j
GRAPH_DIR=./data/graph
GCS_GRAPH_PREFIX=graph
# WIPE_ALL_ON_SYNC=false
# FORCE_RELOAD_TAGS=batch02
# MATCH_MIN_OVERLAP=0.5
